{
  "manifest_version": 3,
  "name": "CleanNews Vault",
  "version": "5.3.0",
  "description": "Extrae y guarda artículos limpios desde un Side Panel. Biblioteca personal con colecciones, notas, resaltados, fragmentos, herramientas, pomodoro y exportación.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "sidePanel",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "CleanNews Vault"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+E",
        "mac": "Alt+E"
      },
      "description": "Abrir CleanNews Vault"
    },
    "save-current-page": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Guardar página actual"
    },
    "toggle-favorite": {
      "suggested_key": {
        "default": "Alt+F",
        "mac": "Alt+F"
      },
      "description": "Marcar como favorito"
    },
    "next-in-queue": {
      "suggested_key": {
        "default": "Alt+N",
        "mac": "Alt+N"
      },
      "description": "Siguiente en cola de lectura"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "1024": "icons/icon1024.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/readability.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
